+    post(name,true,`resize() не принял cssW=0 (мир остался ${r.wAfterZero}×${r.hAfterZero}), drawImage не упал`);
+  }catch(e){ post(name,false,e.message.split('\n')[0]); }
+  finally{ if(ctx) await ctx.close(); }
+}
